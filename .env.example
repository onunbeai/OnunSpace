OPENROUTER_API_KEY=
# Higgsfield: paste the complete API key from the dashboard into one variable.
# A combined ID:SECRET value is accepted as-is; do not add a second secret.
HF_CREDENTIALS=
# Optional alias for a complete key (used when HF_CREDENTIALS is empty):
HF_KEY=
# Legacy alternate form; HF_API_KEY also accepts a complete key by itself:
HF_API_KEY=
HF_API_SECRET=
ONUN_PORT=4318
# Optional absolute project-data location. Default: .onun/ in the working directory.
ONUN_DATA_DIR=
# MCP runtime; loopback HTTP only.
ONUN_RUNTIME_URL=http://127.0.0.1:4318
# Optional local renderer binaries:
ONUN_FFMPEG_PATH=
ONUN_CHROMIUM_PATH=
